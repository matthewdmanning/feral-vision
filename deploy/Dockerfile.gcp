ARG CUDA_IMAGE=nvidia/cuda:13.0.0-base-ubuntu24.04@sha256:6e43a6b02e5f16e4a715953be8b29c40acbe84aed11a61357ef0fc899967fbd9
FROM ${CUDA_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=0 \
    UV_NO_DEV=1 \
    PATH="/workspace/.venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        libgl1 \
        libglib2.0-0 \
        python3.12 \
        python3.12-venv \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
        > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-cloud-cli \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.18@sha256:3adc3706091ce7c2fe595e669628caedd6d951551b92b258b7e7dbe06d9440bc \
    /uv /uvx /usr/local/bin/

WORKDIR /workspace
COPY pyproject.toml uv.lock ./
COPY src/ ./src/
COPY conf/ ./conf/
COPY scripts/runs/container_train.sh ./scripts/runs/container_train.sh

# The repository lockfile pins PyTorch 2.12.1 and its CUDA 13 user-space
# dependencies. Keep the NVIDIA base on CUDA 13 as well, but use the small base
# image rather than installing a second cuDNN stack beneath PyTorch's locked one.
# Do not resolve or update dependencies during image construction.
RUN uv sync --frozen --no-dev --no-editable

# Fail the image build if the canonical recipe cannot be composed or if core
# runtime imports are missing. GPU visibility is checked on the actual VM.
RUN python -c "import torch, hydra, feral_vision; print(torch.__version__)" \
    && python -m feral_vision.training.trainer --config-name runs/detection --cfg job >/tmp/resolved-training-config.yaml \
    && gcloud version >/dev/null \
    && bash -n /workspace/scripts/runs/container_train.sh

ENTRYPOINT ["bash", "/workspace/scripts/runs/container_train.sh"]
