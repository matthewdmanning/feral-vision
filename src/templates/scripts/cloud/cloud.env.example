# Placeholder values for scripts/cloud/*_training_image.sh.
# Copy to cloud.env.local (gitignored), fill in real values, then load it:
#   set -a; . feral-vision/scripts/cloud/cloud.env.local; set +a
# Command-line flags override these values. Never commit real values.
GCP_PROJECT=YOUR_PROJECT_ID
GCP_REGION=us-east4
ARTIFACT_REPOSITORY=feral-docker
TRAINING_IMAGE_NAME=feral-vision-gcp
BUILD_SERVICE_ACCOUNT=BUILD_SERVICE_ACCOUNT_NAME@YOUR_PROJECT_ID.iam.gserviceaccount.com
