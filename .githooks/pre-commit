#!/bin/sh
# Block commit if secret, lint, or format checks fail.

echo "[pre-commit] Scanning staged changes for secrets..."
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] gitleaks is not installed — install it, then re-commit."
  exit 1
fi
gitleaks git --staged --redact --no-banner
status=$?
if [ $status -ne 0 ]; then
  echo "[pre-commit] Possible secret found — remove it from the staged changes, then re-commit."
  exit 1
fi
echo "[pre-commit] No secrets found."

echo "[pre-commit] Running linter..."
uv run ruff check src tests
status=$?
if [ $status -ne 0 ]; then
  echo "[pre-commit] Lint errors found — run 'uv run ruff check --fix src tests' to fix, then re-commit."
  exit 1
fi
echo "[pre-commit] Linter passed."

echo "[pre-commit] Running formatter check..."
uv run ruff format --check src tests
status=$?
if [ $status -ne 0 ]; then
  echo "[pre-commit] Formatting issues found — run 'uv run ruff format src tests' to fix, then re-commit."
  exit 1
fi
echo "[pre-commit] Formatter passed."
