{
  "mcpServers": {
    "model-inspector": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "python",
        "mcp/server/main.py"
      ],
      "env": {
        "PROJECT_ROOT": "."
      }
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    }
  }
}
