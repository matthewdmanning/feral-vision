#!/usr/bin/env bash
set -euo pipefail

readonly training_image="${training_image}"
readonly dataset_uri="gs://${bucket_name}/${dataset_artifact_prefix}"
readonly dataset_mount_dir="${dataset_mount_dir}"
readonly mlflow_tracking_uri="${mlflow_tracking_uri}"

mkdir -p "$dataset_mount_dir"
docker pull "$training_image"

docker run --rm \
  -v /mnt/disks/ssd:/data \
  --entrypoint gcloud \
  "$training_image" storage rsync --recursive --checksums-only \
  "$dataset_uri/payload" "$dataset_mount_dir"

for metadata_file in dataset-artifact.json dataset-artifact.dvc; do
  docker run --rm \
    -v /mnt/disks/ssd:/data \
    --entrypoint gcloud \
    "$training_image" storage cp "$dataset_uri/$metadata_file" "$dataset_mount_dir/$metadata_file"
done

test -d "$dataset_mount_dir/images"
test -d "$dataset_mount_dir/annotations"
test -f "$dataset_mount_dir/dataset-artifact.json"
test -f "$dataset_mount_dir/dataset-artifact.dvc"

docker run --rm \
  --gpus all \
  --entrypoint python \
  "$training_image" -c 'import torch; assert torch.cuda.is_available(); print(torch.cuda.get_device_name(0))'

docker run --rm \
  --gpus all \
  -v /mnt/disks/ssd:/data \
  -e TRAIN_DATA="$dataset_mount_dir" \
  -e MLFLOW_TRACKING_URI="$mlflow_tracking_uri" \
  "$training_image"
