#!/usr/bin/env bash
set -euo pipefail

readonly source_dataset_uri="gs://${bucket_name}/${source_dataset_artifact_prefix}"
readonly source_annotation_uri="$source_dataset_uri/payload/annotations/instances.json#${source_annotation_generation}"
readonly target_dataset_uri="gs://${bucket_name}/${target_dataset_artifact_prefix}"
readonly workspace_dir="/mnt/disks/ssd/dvc-publication"

cleanup() {
  status="$?"

  if [ "$status" -ne 0 ]; then
    echo "DVC publication failed; retaining $workspace_dir for diagnosis." >&2
    exit "$status"
  fi

  rm -rf "$workspace_dir"
  shutdown -h now || true
  exit "$status"
}
trap cleanup EXIT

apt-get update
apt-get install -y --no-install-recommends ca-certificates curl gnupg python3-pip
curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --batch --yes --dearmor -o /usr/share/keyrings/cloud.google.gpg
echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" > /etc/apt/sources.list.d/google-cloud-sdk.list
apt-get update
apt-get install -y --no-install-recommends google-cloud-cli
python3 -m pip install --no-cache-dir dvc-gs google-cloud-storage

TARGET_DATASET_URI="$target_dataset_uri" python3 - <<'PY'
import os

from google.cloud import storage

bucket_name, prefix = os.environ["TARGET_DATASET_URI"][5:].split("/", 1)
if next(storage.Client().bucket(bucket_name).list_blobs(prefix=f"{prefix}/", max_results=1), None):
    raise SystemExit(f"Refusing to overwrite immutable Dataset Artifact: {os.environ['TARGET_DATASET_URI']}")
PY

mkdir -p "$workspace_dir/payload/images" "$workspace_dir/payload/annotations"
gcloud storage rsync --recursive --checksums-only --dry-run --quiet "$source_dataset_uri/payload/images" "$workspace_dir/payload/images"
gcloud storage rsync --recursive --checksums-only --quiet "$source_dataset_uri/payload/images" "$workspace_dir/payload/images"
gcloud storage cp --quiet "$source_annotation_uri" "$workspace_dir/payload/annotations/instances.json"
gcloud storage cp --quiet "$source_dataset_uri/dataset-artifact.json" "$workspace_dir/dataset-artifact.json"

test -n "$(find "$workspace_dir/payload/images" -type f -print -quit)"
test -s "$workspace_dir/payload/annotations/instances.json"

SOURCE_DATASET_URI="$source_dataset_uri" SOURCE_ANNOTATION_URI="$source_annotation_uri" python3 - <<'PY'
import json
import os
from pathlib import Path

manifest_path = Path("/mnt/disks/ssd/dvc-publication/dataset-artifact.json")
manifest = json.loads(manifest_path.read_text())
manifest["source_dataset_artifact"] = os.environ["SOURCE_DATASET_URI"]
manifest["source_annotation"] = os.environ["SOURCE_ANNOTATION_URI"]
manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
PY

cd "$workspace_dir"
dvc init --no-scm
dvc remote add --default dataset "$target_dataset_uri/dvc"
dvc add payload
dvc commit payload.dvc
dvc stage add --name dataset --deps payload true
dvc repro dataset
dvc push
mv payload.dvc dataset-artifact.dvc

gcloud storage rsync --recursive --checksums-only --dry-run --quiet "$workspace_dir/payload" "$target_dataset_uri/payload"
gcloud storage rsync --recursive --checksums-only --quiet "$workspace_dir/payload" "$target_dataset_uri/payload"
for metadata_file in dataset-artifact.json dataset-artifact.dvc dvc.lock; do
  gcloud storage cp --no-clobber --quiet "$workspace_dir/$metadata_file" "$target_dataset_uri/$metadata_file"
done

gcloud storage objects describe "$target_dataset_uri/dvc.lock" --quiet
